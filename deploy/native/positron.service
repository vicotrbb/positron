[Unit]
Description=Positron observability database
After=network.target

[Service]
Type=simple
User=positron
Group=positron
ExecStart=/usr/local/lib/positron/bin/positron serve --config /etc/positron/positron.toml
Restart=on-failure
KillSignal=SIGTERM
TimeoutStopSec=65
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/positron /var/lib/positron-secrets /run/positron
RuntimeDirectory=positron
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
