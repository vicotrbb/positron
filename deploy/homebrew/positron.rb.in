# Generated by positron release homebrew from the Release Inventory.
# Upstream source: @SOURCE@
class Positron < Formula
  desc "Standalone observability database"
  homepage "https://github.com/vicotrbb/positron"
  version "@VERSION@"
  license "MIT"

  depends_on :macos

  on_macos do
    depends_on macos: :sequoia
    on_arm do
      url "https://github.com/vicotrbb/positron/releases/download/v@VERSION@/@ARM_FILE@"
      sha256 "@ARM_SHA256@"
    end
    on_intel do
      url "https://github.com/vicotrbb/positron/releases/download/v@VERSION@/@INTEL_FILE@"
      sha256 "@INTEL_SHA256@"
    end
  end

  def install
    bin.install "bin/positron"
    (pkgshare/"config").install "etc/positron.toml.example"
    pkgshare.install "share/config.schema.json", "share/configuration.md"
    (pkgshare/"operations").install Dir["docs/operations/*"]
    doc.install "README.md"
  end

  def caveats
    <<~EOS
      Initialize explicitly before starting this user service. Read:
        #{pkgshare}/operations/homebrew.md
      Configuration: #{etc}/positron/positron.toml
      Keep data, secrets and runtime in separate owner-only directories under:
        #{var}/lib/positron
        #{var}/lib/positron-secrets
        #{var}/run/positron
      Set runtime.shutdown_grace_seconds <= 60 for the 65-second stop budget.
      Stop and complete the authenticated native Upgrade workflow before brew upgrade.
      brew uninstall retains your configuration, data, secrets, trust and backups.
      Install and run brew services as your ordinary user, without sudo.
    EOS
  end

  service do
    run [opt_bin/"positron", "serve", "--config", etc/"positron/positron.toml"]
    require_root false
    keep_alive false
    process_type :background
    stop_timeout 65
    working_dir var
    log_path var/"run/positron/stdout.log"
    error_log_path var/"run/positron/stderr.log"
  end

  test do
    assert_match "release verify", shell_output("#{bin}/positron release --help")
  end
end
